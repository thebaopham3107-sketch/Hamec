# ═══════════════════════════════════════════════════════════════════════════
#  NGHÉ — CẤU HÌNH (copy file này thành ".env" rồi điền các dòng BẮT BUỘC)
#  Mẹo: chạy `node whoami.mjs`, nhắn 1 tin vào nhóm điều khiển → nó in sẵn 2 dòng
#  OWNER_OPEN_ID và CONTROL_CHAT_ID cho bạn dán vào.
# ═══════════════════════════════════════════════════════════════════════════

# ── LARK (bắt buộc) ──────────────────────────────────────────────────────────
# open_id của CHỦ — CHỈ người này ra lệnh được (lấy bằng whoami.mjs).
OWNER_OPEN_ID=
# Nhóm điều khiển — bot chỉ gửi/nhận trong đúng nhóm này (lấy bằng whoami.mjs).
CONTROL_CHAT_ID=
# LARK_WEBHOOK chỉ dùng cho watchdog gửi cảnh báo 24/7 (tuỳ chọn). Bridge KHÔNG cần.
LARK_WEBHOOK=

# ── THƯ MỤC CLAUDE LÀM VIỆC ──────────────────────────────────────────────────
# Để trống = thư mục cha của repo. Đặt đường dẫn tuyệt đối tới "bộ não"/dự án bạn
# muốn Claude thao tác khi nhận lệnh qua Lark.  Vd: C:\Users\Ban\bo-nao
BRAIN_ROOT=

# ── CLAUDE (bộ não NGHÉ) ──────────────────────────────────────────────────────
CLAUDE_MODEL=sonnet
PERMISSION_MODE=bypassPermissions
KEEP_SESSION=true
CLAUDE_TIMEOUT_MS=1500000
# Bật true để TEST luồng Lark mà KHÔNG gọi Claude thật (không tốn token).
DRY_RUN=false

# ── VOICE ────────────────────────────────────────────────────────────────────
# true = tin THOẠI Lark → nghe (whisper) → NGHÉ → trả lời bằng GIỌNG (edge-tts).
VOICE_REPLY=true
# Giọng đọc tiếng Việt (edge-tts, MIỄN PHÍ): nữ vi-VN-HoaiMyNeural | nam vi-VN-NamMinhNeural
VOICE_CODE=vi-VN-HoaiMyNeural
# Model nghe: tiny|base|small|medium|large-v3
#   small  = nhanh, hợp máy yếu / chạy CPU
#   medium = chuẩn tiếng Việt hơn (nên dùng nếu có GPU NVIDIA + đã cài cuBLAS/cuDNN)
WHISPER_MODEL=small
WHISPER_PORT=8765
# Python của venv. install.ps1 tự điền dòng này. Nếu chạy tay, trỏ tới .venv:
#   PYTHON_BIN=<thư mục repo>\scripts\.venv\Scripts\python.exe
PYTHON_BIN=

# ── CHĂM SÓC KHÁCH (tuỳ chọn — mặc định TẮT) ─────────────────────────────────
# Phải ghi rõ false: trong code, để trống là MẶC ĐỊNH BẬT.
CARE_MODE=false
CARE_MODEL=haiku

# ── (Hiếm khi cần) đường dẫn tuyệt đối nếu công cụ không có trên PATH ─────────
# LARK_CLI_BIN=
# Máy có nhiều app Lark: dùng profile riêng cho NGHÉ (xem docs/01-cai-dat-nen.md, mục macOS)
# LARK_CLI_PROFILE=nghe
# LARK_CLI_BIN=<repo>/scripts/lark-cli-profile.sh
# CLAUDE_BIN=claude
# FFMPEG_BIN=ffmpeg
# Dùng script Vbee TTS (trả phí) thay edge-tts:
# VBEE_SCRIPT=<repo>\scripts\text_to_mp3_vbee.py   # + VBEE_API + VBEE_APP_ID
# VBEE_API=
# VBEE_APP_ID=
